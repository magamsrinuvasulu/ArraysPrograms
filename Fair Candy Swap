class Solution {
    public int[] fairCandySwap(int[] aliceSizes, int[] bobSizes) {
        int a=0,b=0;
        for(int x:aliceSizes)
        a+=x;
        for(int x:bobSizes)
        b+=x;
        int diff=(b-a)/2;
        for(int x:aliceSizes)
        {
            for(int y:bobSizes){
                if(y-x==diff)
                    return new int[]{x,y};
            }
        }
        return new int[0];
    }
}
